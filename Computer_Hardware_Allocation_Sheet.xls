    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">02-09-2026</Data></Cell>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="String">Assigned</Data></Cell>
    <Cell ss:StyleID="DataLeft"><Data ss:Type="String">Working OK</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="DataCenter"><Data ss:Type="Number">2</Data></Cell>
