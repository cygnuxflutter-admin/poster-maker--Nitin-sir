<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1200">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_loading_ad_card"
        android:padding="8dp">

        <!-- Ad Attribution Badge Skeleton -->
        <View
            android:id="@+id/shimmer_ad_badge"
            android:layout_width="28dp"
            android:layout_height="16dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="#E2E8F0" />

        <!-- MediaView Skeleton (Large Ad Image / Video Placeholder) -->
        <View
            android:id="@+id/shimmer_ad_media"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:background="#E2E8F0" />

        <!-- Headline Skeleton -->
        <View
            android:id="@+id/shimmer_ad_headline"
            android:layout_width="200dp"
            android:layout_height="15dp"
            android:layout_below="@id/shimmer_ad_media"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:background="#E2E8F0" />

        <!-- Body / Description Skeleton -->
        <View
            android:id="@+id/shimmer_ad_body"
            android:layout_width="260dp"
            android:layout_height="11dp"
            android:layout_below="@id/shimmer_ad_headline"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:background="#E2E8F0" />

        <!-- Call To Action Button Skeleton (Full width rounded button matching 42dp) -->
        <View
            android:id="@+id/shimmer_ad_cta"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_below="@id/shimmer_ad_body"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="#CBD5E1" />

    </RelativeLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
