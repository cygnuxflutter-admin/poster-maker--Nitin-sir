<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_onboarding_step3"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#FFFFFF">

    <!-- TOP BAR -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button_flat"
            android:src="@drawable/ic_arrow_back"
            android:padding="9dp"
            android:visibility="visible"
            app:tint="#1E293B" />

        <!-- Animated Expanding Pill & Dot Step Indicator: Step 3 Active -->
        
    </RelativeLayout>

    <!-- BOTTOM SECTION: Native Ad Container + Get Started Button -->
    <LinearLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <!-- Native Ad Container -->
        <RelativeLayout
            android:id="@+id/native_ad_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@android:color/transparent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <TextView
                android:id="@+id/btn_continue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_onboarding_btn_primary"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:gravity="center"
                android:text="Get Started  →"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <ProgressBar
                android:id="@+id/progress_continue"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- CENTER CONTENT: STEP 3 SHARE SHOWCASE -->
    <LinearLayout
        android:id="@+id/center_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_container"
        android:layout_below="@id/top_bar"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Sharing Showcase Stage -->
        <RelativeLayout
            android:id="@+id/share_stage"
            android:layout_width="match_parent"
            android:layout_height="228dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center">

            <!-- Ambient Glow Behind Poster -->
            <View
                android:id="@+id/glow_bg_step3"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_onboarding_glow" />

            <!-- Ready Poster Card (Center) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_share_poster"
                android:layout_width="122dp"
                android:layout_height="180dp"
                android:layout_centerInParent="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_share_poster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/onboard_p6_fashion_edit" />

                    <!-- Ultra HD No Watermark Badge at bottom edge -->
                    <TextView
                        android:id="@+id/badge_ultra_hd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:background="#B3000000"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="✨ ULTRA HD • NO WATERMARK"
                        android:textColor="#FFFFFF"
                        android:textSize="8sp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Saved in HD Badge (App Blue Theme) -->
            <TextView
                android:id="@+id/badge_saved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/card_share_poster"
                android:layout_alignEnd="@id/card_share_poster"
                android:layout_marginTop="-10dp"
                android:layout_marginEnd="-10dp"
                android:background="@drawable/bg_saved_hd_pill"
                android:elevation="14dp"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="✓ HD Saved"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <!-- Sparkle 1: Gold (Top-Right) -->
            <ImageView
                android:id="@+id/iv_sparkle_gold"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:elevation="12dp"
                android:src="@drawable/spawner_ic_sparkle" />

            <!-- Sparkle 2: Purple (Bottom-Left) -->
            <ImageView
                android:id="@+id/iv_sparkle_purple"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="14dp"
                android:elevation="12dp"
                android:src="@drawable/spawner_ic_sparkle_purple" />

            <!-- WhatsApp Floating Card (Top-Left) -->
            <RelativeLayout
                android:id="@+id/card_share_whatsapp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="6dp"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Bubble: '💬 Sent to Status!' -->
                <TextView
                    android:id="@+id/bubble_whatsapp_sent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/spawner_bg_floating_pill"
                    android:elevation="14dp"
                    android:fontFamily="@font/leaflet_visbyroundcf_bold"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="💬 Sent to Status!"
                    android:textColor="#059669"
                    android:textSize="9.5sp" />

                <!-- WhatsApp Horizontal Rounded Pill Card -->
                <LinearLayout
                    android:id="@+id/node_whatsapp_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/bubble_whatsapp_sent"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card_share_whatsapp"
                    android:elevation="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_social_node_whatsapp"
                        android:padding="8dp"
                        android:src="@drawable/ic_whatsapp_white" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/leaflet_visbyroundcf_bold"
                            android:text="WhatsApp"
                            android:textColor="#111827"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/leaflet_visbyroundcf_medium"
                            android:text="Status &amp; Chats"
                            android:textColor="#16A34A"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- Instagram Floating Card (Bottom-Right) -->
            <RelativeLayout
                android:id="@+id/card_share_instagram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Bubble: '❤️ 99+ Likes' -->
                <TextView
                    android:id="@+id/bubble_instagram_likes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/spawner_bg_tag_pill"
                    android:elevation="14dp"
                    android:fontFamily="@font/leaflet_visbyroundcf_bold"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="❤️ 99+ Likes"
                    android:textColor="#E11D48"
                    android:textSize="9.5sp" />

                <!-- Instagram Horizontal Rounded Pill Card -->
                <LinearLayout
                    android:id="@+id/node_instagram_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/bubble_instagram_likes"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card_share_instagram"
                    android:elevation="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_social_node_instagram"
                        android:padding="6.5dp"
                        android:src="@drawable/ic_instagram_white" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/leaflet_visbyroundcf_bold"
                            android:text="Instagram"
                            android:textColor="#111827"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/leaflet_visbyroundcf_medium"
                            android:text="Story &amp; Feed"
                            android:textColor="#E11D48"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

        </RelativeLayout>

        <!-- Bottom Quick Share Bar: 4 Authentic Social Buttons -->
        <LinearLayout
            android:id="@+id/ll_quick_share_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_quick_share_bar"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <!-- 1. WhatsApp Button -->
            <LinearLayout
                android:id="@+id/btn_share_whatsapp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_social_node_whatsapp"
                    android:padding="9.5dp"
                    android:src="@drawable/ic_whatsapp_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/leaflet_visbyroundcf_bold"
                    android:text="WhatsApp"
                    android:textColor="#374151"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <!-- 2. Instagram Button -->
            <LinearLayout
                android:id="@+id/btn_share_instagram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_social_node_instagram"
                    android:padding="8dp"
                    android:src="@drawable/ic_instagram_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/leaflet_visbyroundcf_bold"
                    android:text="Instagram"
                    android:textColor="#374151"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <!-- 3. Facebook Button -->
            <LinearLayout
                android:id="@+id/btn_share_facebook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_social_node_facebook"
                    android:padding="9.5dp"
                    android:src="@drawable/ic_facebook_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/leaflet_visbyroundcf_bold"
                    android:text="Facebook"
                    android:textColor="#374151"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <!-- 4. Save HD Button -->
            <LinearLayout
                android:id="@+id/btn_share_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_social_more_purple"
                    android:padding="7dp"
                    android:src="@drawable/ic_more_horiz_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/leaflet_visbyroundcf_bold"
                    android:text="Save HD"
                    android:textColor="#374151"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/leaflet_visbyroundcf_bold"
            android:gravity="center"
            android:text="Ready. Set. Share!"
            android:textColor="#111827"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/leaflet_visbyroundcf_medium"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="“Create, Download &amp; Share in Seconds”"
            android:textColor="#6B7280"
            android:textSize="12sp" />

    </LinearLayout>

</RelativeLayout>
