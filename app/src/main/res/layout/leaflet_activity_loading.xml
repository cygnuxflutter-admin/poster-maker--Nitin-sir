<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Bottom Native Ad Container -->
    <RelativeLayout
        android:id="@+id/fl_native_ad_container"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp">

        <!-- Shimmer Placeholder before ad loads -->
        <include
            android:id="@+id/shimmer_loading_ad"
            layout="@layout/layout_loading_native_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </RelativeLayout>

    <!-- Progress Section pinned right above the Native Ad -->
    <LinearLayout
        android:id="@+id/ll_progress_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/fl_native_ad_container"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:text="0%"
                android:textColor="#0066FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/progress_loading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_loading_progress_bar" />

    </LinearLayout>

    <!-- Upper Content Area: Illustration + Flipping Posters + Headings -->
    <RelativeLayout
        android:id="@+id/rl_upper_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/ll_progress_section"
        android:gravity="center">

        <!-- Illustration Hub (Background Disc + Dashed Canvas + Flipping Poster Cards) -->
        <RelativeLayout
            android:id="@+id/rl_canvas_hub"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_centerHorizontal="true">

            <!-- Soft Pastel Lilac Circular Background Disc -->
            <View
                android:id="@+id/view_disc_bg"
                android:layout_width="230dp"
                android:layout_height="230dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_loading_circle_disc" />

            <!-- Dashed Outer Canvas Guide Frame -->
            <View
                android:id="@+id/view_canvas_sheet"
                android:layout_width="144dp"
                android:layout_height="192dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_loading_dashed_canvas" />

            <!-- Poster Card with Rounded Corners inside Dashed Frame -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_poster_container"
                android:layout_width="134dp"
                android:layout_height="182dp"
                android:layout_centerInParent="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- ================= BLANK CANVAS BASE LAYER ================= -->
                    <RelativeLayout
                        android:id="@+id/layout_blank_canvas"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF"
                        android:padding="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_blank_canvas_inner_border" />

                        <!-- Sketched Header Banner (drawn by pencil) -->
                        <View
                            android:id="@+id/sketch_header"
                            android:layout_width="74dp"
                            android:layout_height="10dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_sketch_element_blue"
                            android:alpha="0" />

                        <!-- Sketched Graphic/Photo Frame (drawn by pencil) -->
                        <FrameLayout
                            android:id="@+id/sketch_art_box"
                            android:layout_width="74dp"
                            android:layout_height="60dp"
                            android:layout_centerInParent="true"
                            android:background="@drawable/bg_sketch_frame_dashed"
                            android:alpha="0">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_sketch_photo"
                                app:tint="#60A5FA" />
                        </FrameLayout>

                        <!-- Sketched Text Lines (drawn by pencil) -->
                        <LinearLayout
                            android:id="@+id/sketch_lines_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:alpha="0">

                            <View
                                android:id="@+id/sketch_line_1"
                                android:layout_width="76dp"
                                android:layout_height="5dp"
                                android:background="@drawable/bg_sketch_element_gray" />

                            <View
                                android:id="@+id/sketch_line_2"
                                android:layout_width="52dp"
                                android:layout_height="5dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_sketch_element_gray" />
                        </LinearLayout>

                    </RelativeLayout>

                    <!-- Active Poster Image (Revealed once sketched on blank canvas) -->
                    <ImageView
                        android:id="@+id/img_poster_active"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:alpha="0" />

                    <!-- Next Poster Image -->
                    <ImageView
                        android:id="@+id/img_poster_next"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <!-- Subtle bottom vignette overlay -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_alignParentBottom="true"
                        android:background="#15000000" />

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <!-- Dynamic Drawing Pencil Icon sketching the poster -->
            <ImageView
                android:id="@+id/img_drawing_pencil"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_alignStart="@id/card_poster_container"
                android:layout_alignTop="@id/card_poster_container"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="-16dp"
                android:elevation="10dp"
                android:src="@drawable/ic_loading_pencil" />

            <!-- Floating Category Tag Pill (e.g. "✨ FESTIVAL", "🔥 50% SALE") -->
            <TextView
                android:id="@+id/tv_poster_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_alignBottom="@id/card_poster_container"
                android:layout_marginBottom="-11dp"
                android:background="@drawable/bg_loading_tag_pill"
                android:elevation="6dp"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:gravity="center"
                android:text="✨ FESTIVAL"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Twinkling Sparkle top-left -->
            <ImageView
                android:id="@+id/img_sparkle_1"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:src="@drawable/spawner_ic_sparkle_purple" />

            <!-- Twinkling Sparkle bottom-right -->
            <ImageView
                android:id="@+id/img_sparkle_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="28dp"
                android:src="@drawable/spawner_ic_sparkle_purple" />

            <!-- Extra Sparkle top-right -->
            <ImageView
                android:id="@+id/img_sparkle_3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="36dp"
                android:layout_marginTop="42dp"
                android:src="@drawable/spawner_ic_sparkle_purple" />

        </RelativeLayout>

        <!-- Main Title -->
        <TextView
            android:id="@+id/tv_loading_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/rl_canvas_hub"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/leaflet_visbyroundcf_bold"
            android:gravity="center"
            android:text="Crafting Your Studio"
            android:textColor="#18181B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Dynamic Subtitle -->
        <TextView
            android:id="@+id/tv_loading_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_loading_title"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/leaflet_visbyroundcf_medium"
            android:gravity="center"
            android:text="Curating 10,000+ Trending Templates..."
            android:textColor="#0066FF"
            android:textSize="14sp" />

    </RelativeLayout>

</RelativeLayout>
