<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lay_textEdit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_above="@+id/bottom_ly"
    android:splitMotionEvents="false"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/rellative"
            android:layout_width="fill_parent"
            android:layout_height="100.0dip"
            android:splitMotionEvents="false">

            <LinearLayout
                android:id="@+id/ly_txt_controls"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:splitMotionEvents="false"
                android:visibility="visible">

                <!-- Row 1: Action buttons [ Duplicate ] [ Edit ] [ Lock ] [ Delete ] -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Duplicate Button -->
                    <RelativeLayout
                        android:id="@+id/lay_dupliText"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_duplicate_copy_white"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                                android:includeFontPadding="false"
                                android:text="Duplicate"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Edit Button -->
                    <RelativeLayout
                        android:id="@+id/lay_edit"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_edit_pencil_white"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                                android:includeFontPadding="false"
                                android:text="Edit"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Lock Button -->
                    <RelativeLayout
                        android:id="@+id/lay_txt_lock"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_poster_center_lock"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                                android:includeFontPadding="false"
                                android:text="Lock"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Delete Button -->
                    <RelativeLayout
                        android:id="@+id/lay_txt_delete"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_delete_trash_white"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                                android:includeFontPadding="false"
                                android:text="Delete"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </RelativeLayout>

                </LinearLayout>

                <!-- Row 2: Precision Arrow Buttons [ < ] [ ^ ] [ v ] [ > ] -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Left Arrow -->
                    <RelativeLayout
                        android:id="@+id/txt_btnLeft"
                        android:layout_width="54dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/leaflet_bt_left"
                            app:tint="@color/white" />
                    </RelativeLayout>

                    <!-- Up Arrow -->
                    <RelativeLayout
                        android:id="@+id/txt_btn_up"
                        android:layout_width="54dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/leaflet_bt_up"
                            app:tint="@color/white" />
                    </RelativeLayout>

                    <!-- Down Arrow -->
                    <RelativeLayout
                        android:id="@+id/txt_btnDown"
                        android:layout_width="54dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/leaflet_bt_down"
                            app:tint="@color/white" />
                    </RelativeLayout>

                    <!-- Right Arrow -->
                    <RelativeLayout
                        android:id="@+id/txt_btnRight"
                        android:layout_width="54dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/leaflet_bt_right"
                            app:tint="@color/white" />
                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_txt_rotation"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:splitMotionEvents="false"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/text_view_rotate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:textColor="@color/selected"
                        android:textSize="13sp" />

                    <com.online.flyer.design.postermaker.Leaflet_view.Leaflet_HorizontalProgressWheelView
                        android:id="@+id/rotate_scroll_wheel"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:layout_below="@+id/text_view_rotate"
                        android:layout_toStartOf="@+id/wrapper_rotate_by_angle"
                        android:layout_toEndOf="@+id/wrapper_reset_rotate" />


                    <FrameLayout
                        android:id="@+id/wrapper_reset_rotate"
                        style="@style/ucrop_WrapperRotateButton"
                        android:layout_below="@+id/text_view_rotate"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/leaflet_ic_reset"
                            app:tint="@color/selected" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/wrapper_rotate_by_angle"
                        style="@style/ucrop_WrapperRotateButton"
                        android:layout_below="@+id/text_view_rotate"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/ucrop_ic_angle"
                            app:tint="@color/selected" />

                    </FrameLayout>

                </RelativeLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_fonts"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:splitMotionEvents="false"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fonts_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="4.0dip"
                    android:orientation="vertical"
                    android:verticalSpacing="2.0dip" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_txt_color"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:splitMotionEvents="false"
                android:visibility="gone"
                android:weightSum="2.0">

                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_marginLeft="7.0dip"
                    android:layout_marginRight="7.0dip"
                    android:layout_weight="1.0">

                    <ImageView
                        android:id="@+id/imga"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_centerVertical="true"
                        android:layout_margin="5.0dip"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:src="@drawable/leaflet_ic_br_tranfarant"
                        app:tint="@color/white" />

                    <SeekBar
                        android:id="@+id/txt_alpha_seekbar"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="5.0dip"
                        android:layout_marginRight="5.0dip"
                        android:layout_toEndOf="@+id/imga"
                        android:max="100"
                        android:maxHeight="2dp"
                        android:progress="50"
                        android:progressDrawable="@drawable/leaflet_seekbar_new"
                        android:thumbTint="@color/new_selected" />


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_marginLeft="7.0dip"
                    android:layout_marginRight="7.0dip"
                    android:layout_weight="1.0">

                    <ImageView
                        android:id="@+id/btn_pickColor"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5.0dip"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:src="@drawable/leaflet_ic_color"
                        app:tint="@color/white" />

                    <com.online.flyer.design.postermaker.Leaflet_color_palette.Leaflet_LineColorPicker
                        android:id="@+id/txt_color_LineColorPicker"
                        android:layout_width="fill_parent"
                        android:layout_height="35.0dip"
                        android:layout_centerInParent="true"
                        android:layout_marginLeft="15.0dip"
                        android:layout_marginRight="15.0dip"
                        android:layout_toEndOf="@+id/btn_pickColor"
                        app:orientation="horizontal" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_txt_shadow"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:splitMotionEvents="false"
                android:visibility="gone"
                android:weightSum="2.0">

                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_marginLeft="11.0dip"
                    android:layout_marginRight="11.0dip"
                    android:layout_weight="1.0">

                    <ImageView
                        android:id="@+id/btn_shadow_minus"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_margin="5.0dip"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:src="@drawable/leaflet_ic_minus"
                        app:tint="@color/white" />

                    <SeekBar
                        android:id="@+id/seekBar_txt_shadow"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="40.0dip"
                        android:layout_marginRight="40.0dip"
                        android:max="20"
                        android:maxHeight="2dp"
                        android:progressDrawable="@drawable/leaflet_seekbar_new"
                        android:thumbTint="@color/new_selected" />

                    <ImageView
                        android:id="@+id/btn_shadow_plus"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="7.0dip"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:src="@drawable/leaflet_ic_plus"
                        app:tint="@color/white" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_marginLeft="7.0dip"
                    android:layout_marginRight="7.0dip"
                    android:layout_weight="1.0">

                    <ImageView
                        android:id="@+id/btn_txt_shadow_picker"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5.0dip"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:src="@drawable/leaflet_ic_color"
                        app:tint="@color/white" />

                    <com.online.flyer.design.postermaker.Leaflet_color_palette.Leaflet_LineColorPicker
                        android:id="@+id/color_picker_txtShadow"
                        android:layout_width="fill_parent"
                        android:layout_height="35.0dip"
                        android:layout_centerInParent="true"
                        android:layout_marginLeft="15.0dip"
                        android:layout_marginRight="15.0dip"
                        android:layout_toEndOf="@+id/btn_txt_shadow_picker"
                        app:orientation="horizontal" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_txt_bg"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical"
                android:splitMotionEvents="false"
                android:visibility="gone"
                android:weightSum="3.0">

                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_marginLeft="7.0dip"
                    android:layout_marginRight="7.0dip"
                    android:layout_weight="1.0"
                    android:gravity="center">

                    <RelativeLayout
                        android:id="@+id/lay3"
                        android:layout_width="fill_parent"
                        android:layout_height="40.0dip"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="30.0dip"
                            android:layout_height="30.0dip"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="5.0dip"
                            android:background="@drawable/leaflet_btn_rounded_text_bg"
                            android:src="@drawable/leaflet_ic_br_tranfarant"
                            app:tint="@color/white" />

                        <SeekBar
                            android:id="@+id/txt_bg_seekbar"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="40.0dip"
                            android:layout_marginEnd="10.0dip"
                            android:max="255"
                            android:maxHeight="2dp"
                            android:progress="0"
                            android:progressDrawable="@drawable/leaflet_seekbar_new"
                            android:thumbTint="@color/new_selected" />
                    </RelativeLayout>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_marginLeft="7.0dip"
                    android:layout_marginRight="7.0dip"
                    android:layout_weight="1.0">

                    <ImageView
                        android:id="@+id/btn_bg_none"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5.0dip"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:src="@drawable/leaflet_ic_close"
                        app:tint="@color/white" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/txtBg_recycler"
                        android:layout_width="fill_parent"
                        android:layout_height="35.0dip"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10.0dip"
                        android:layout_marginRight="10.0dip"
                        android:layout_toEndOf="@+id/btn_bg_none" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="fill_parent"
                    android:layout_height="0.0dip"
                    android:layout_marginLeft="7.0dip"
                    android:layout_marginRight="7.0dip"
                    android:layout_weight="1.0">


                    <ImageView
                        android:id="@+id/btn_pick_bg_color"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5.0dip"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:src="@drawable/leaflet_ic_color"
                        app:tint="@color/white" />

                    <com.online.flyer.design.postermaker.Leaflet_color_palette.Leaflet_LineColorPicker
                        android:id="@+id/colorPicker_Bg"
                        android:layout_width="fill_parent"
                        android:layout_height="35.0dip"
                        android:layout_centerInParent="true"
                        android:layout_marginLeft="10.0dip"
                        android:layout_marginRight="10.0dip"
                        android:layout_toEndOf="@+id/btn_pick_bg_color"
                        app:orientation="horizontal" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_txt_style"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:splitMotionEvents="false"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/tLay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/boldIV"
                            android:layout_width="57dp"
                            android:layout_height="57dp"
                            android:background="@drawable/leaflet_ripple_effect"
                            android:src="@drawable/leaflet_bold_font"
                            app:tint="@color/selected" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/italicIV"
                            android:layout_width="57dp"
                            android:layout_height="57dp"
                            android:background="@drawable/leaflet_ripple_effect"
                            android:src="@drawable/leaflet_italic_font"
                            app:tint="@color/selected" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/bold_italic_iv"
                            android:layout_width="57dp"
                            android:layout_height="57dp"
                            android:background="@drawable/leaflet_ripple_effect"
                            android:src="@drawable/leaflet_bold_italic_font"
                            app:tint="@color/selected" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/normalIV"
                            android:layout_width="57dp"
                            android:layout_height="57dp"
                            android:background="@drawable/leaflet_ripple_effect"
                            android:src="@drawable/leaflet_normal_font"
                            app:tint="@color/selected" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="45.0dip"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/btn_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:background="@drawable/leaflet_ripple_effect">

                    <TextView
                        android:id="@+id/txt_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginEnd="@dimen/_20sdp"
                        android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                        android:text="@string/txt_controls"
                        android:textColor="@color/new_selected"
                        android:textSize="12.0sp" />
                </RelativeLayout>

                <!--                <View-->
                <!--                    android:layout_width="1.0dip"-->
                <!--                    android:layout_height="fill_parent"-->
                <!--                    android:layout_marginTop="5.0dip"-->
                <!--                    android:layout_marginBottom="5.0dip"-->
                <!--                    android:background="@color/black"-->
                <!--                    android:visibility="visible" />-->

                <RelativeLayout
                    android:id="@+id/btn_rotation"
                    android:layout_width="wrap_content"
                    android:layout_height="fill_parent"
                    android:background="@drawable/leaflet_ripple_effect">

                    <TextView
                        android:id="@+id/txt_rotation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:layout_marginEnd="@dimen/_20sdp"
                        android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                        android:text="@string/txt_rotation"
                        android:textColor="@color/new_selected"
