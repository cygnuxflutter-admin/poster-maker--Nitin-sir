<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_crop_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:keepScreenOn="true">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/top_ly"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <RelativeLayout
            android:id="@+id/btn_backPress"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button_flat"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_arrow_back"
                app:tint="#1E293B" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/leaflet_visbyroundcf_bold"
            android:text="@string/crop"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/done_ly"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button_flat"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerInParent="true"
                android:src="@drawable/leaflet_ic_check"
                app:tint="#0066FF" />
        </RelativeLayout>

    </RelativeLayout>

    <!-- Crop Canvas View Area -->
    <RelativeLayout
        android:id="@+id/rel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_ly"
        android:layout_below="@+id/top_ly"
        android:background="#F8FAFC">

        <com.online.flyer.design.postermaker.Leaflet_cropper.Leaflet_CropImageView
            android:id="@+id/cropImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cropBorderCornerOffset="0dp"
            app:cropBorderCornerThickness="6dp"
            app:cropBorderLineThickness="2dp"
            app:cropBorderCornerColor="#0066FF"
            app:cropBorderLineColor="#0066FF"
            app:cropGuidelines="off" />
    </RelativeLayout>

    <!-- Bottom Aspect Ratio Control Panel -->
    <RelativeLayout
        android:id="@+id/bottom_ly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:orientation="vertical">

            <!-- Top Row: Free Style, 1:1, 16:9 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/freeRatio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="Free Style"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/ratio1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="1:1"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/ratio2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="16:9"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp" />
                </RelativeLayout>

            </LinearLayout>

            <!-- Bottom Row: 9:16, 4:3, 3:4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/ratio3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="9:16"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/ratio4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="4:3"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/ratio5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="3:4"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp" />
                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
