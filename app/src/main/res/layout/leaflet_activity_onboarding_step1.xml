<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_onboarding_step1"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#FFFFFF">

    <!-- TOP BAR -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_button_flat"
            android:src="@drawable/ic_arrow_back"
            android:padding="9dp"
            android:visibility="gone"
            app:tint="#1E293B" />

        <!-- Animated Expanding Pill & Dot Step Indicator: Step 1 Active -->
        
    </RelativeLayout>

    <!-- BOTTOM SECTION: Native Ad Container + Continue Button -->
    <LinearLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <!-- Native Ad Container -->
        <RelativeLayout
            android:id="@+id/native_ad_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@android:color/transparent" />

        <!-- Continue Button -->
        <TextView
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_onboarding_btn_primary"
            android:fontFamily="@font/leaflet_visbyroundcf_bold"
            android:gravity="center"
            android:text="Continue  →"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- CENTER CONTENT: STEP 1 SHOWCASE -->
    <LinearLayout
        android:id="@+id/center_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_container"
        android:layout_below="@id/top_bar"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- Title & Subtitle with Dynamic Transitions -->
        <TextView
            android:id="@+id/tv_title_step1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/leaflet_visbyroundcf_bold"
            android:gravity="center"
            android:text="Festive Greetings &amp; Celebrations"
            android:textColor="#111827"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_subtitle_step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="38dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/leaflet_visbyroundcf_medium"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Ready-to-use templates for Festivals, Business, Birthdays, Sales and all your events."
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <!-- 3D Fan-Out Poster Showcase Stage -->
        <RelativeLayout
            android:id="@+id/poster_stage"
            android:layout_width="match_parent"
            android:layout_height="225dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center">

            <!-- Ambient Radial Glow -->
            <View
                android:id="@+id/glow_bg"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_onboarding_glow" />

            <!-- Left Card (Tilted Left) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_poster_left"
                android:layout_width="114dp"
                android:layout_height="168dp"
                android:layout_centerInParent="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="false">

                <ImageView
                    android:id="@+id/iv_poster_left"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/onboard_p5_diwali" />
            </androidx.cardview.widget.CardView>

            <!-- Right Card (Tilted Right) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_poster_right"
                android:layout_width="114dp"
                android:layout_height="168dp"
                android:layout_centerInParent="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="false">

                <ImageView
                    android:id="@+id/iv_poster_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/onboard_p4_restaurant" />
            </androidx.cardview.widget.CardView>

            <!-- Center Hero Card (Front) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_poster_center"
                android:layout_width="132dp"
                android:layout_height="194dp"
                android:layout_centerInParent="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="10dp"
                app:cardUseCompatPadding="false">

                <ImageView
                    android:id="@+id/iv_poster_center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/onboard_p1_creative" />
            </androidx.cardview.widget.CardView>

            <!-- Floating Badge 1: Festivals (Top Left) -->
            <TextView
                android:id="@+id/badge_festivals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_onboarding_badge"
                android:elevation="6dp"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="🎉 Festivals"
                android:textColor="#111827"
                android:textSize="12sp" />

            <!-- Floating Badge 2: Business (Top Right) -->
            <TextView
                android:id="@+id/badge_business"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_onboarding_badge"
                android:elevation="6dp"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="💼 Business"
                android:textColor="#111827"
                android:textSize="12sp" />

            <!-- Floating Badge 3: Birthday (Bottom Left) -->
            <TextView
                android:id="@+id/badge_birthday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_onboarding_badge"
                android:elevation="6dp"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="🎂 Birthday"
                android:textColor="#111827"
                android:textSize="12sp" />

            <!-- Floating Badge 4: Sale (Bottom Right) -->
            <TextView
                android:id="@+id/badge_sale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_marginBottom="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_onboarding_badge"
                android:elevation="6dp"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="🔥 50% Off Sale"
                android:textColor="#111827"
                android:textSize="12sp" />

        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>
