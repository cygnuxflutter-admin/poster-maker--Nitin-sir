<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:splitMotionEvents="false">

    <RelativeLayout
        android:id="@+id/full_ly"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:splitMotionEvents="false">

        <RelativeLayout
            android:id="@+id/top_ly"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:rotation="180" />

            <TextView
                android:id="@+id/txtHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:gravity="center"
                android:paddingStart="5dp"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textColor="@color/selected"
                android:textSize="15sp"
                tools:ignore="RtlSymmetry" />

            <RelativeLayout
                android:id="@+id/save_ly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <RelativeLayout
                        android:id="@+id/btn_backPress"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_centerInParent="true"
                            app:tint="#1E293B"
                            android:src="@drawable/ic_arrow_back" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/btn_layControls"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/leaflet_ic_n_layer"
                            app:tint="@color/selected" />

                    </RelativeLayout>

                    <FrameLayout
                        android:id="@+id/lay_reset_container"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/btn_reset"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:layout_gravity="center"
                            app:tint="@color/selected"
                            android:src="@drawable/leaflet_ic_n_rotate" />

                        <!-- Changes Indicator Badge Dot -->
                        <View
                            android:id="@+id/dot_reset_indicator"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="9dp"
                            android:background="@drawable/bg_reset_dot_indicator"
                            android:visibility="gone" />

                        <!-- Free Limit Countdown / Ad Badge for Reset -->
                        <TextView
                            android:id="@+id/badge_reset_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="14dp"
                            android:minWidth="14dp"
                            android:paddingHorizontal="3dp"
                            android:layout_gravity="center"
                            android:layout_marginStart="11dp"
                            android:layout_marginBottom="9dp"
                            android:gravity="center"
                            android:textColor="#FFFFFF"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_badge_limit_free"
                            android:clickable="false"
                            android:focusable="false"
                            android:visibility="gone" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/progress_undo_redo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_10sdp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <FrameLayout
                                android:id="@+id/edit_undo"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">

                                <ImageView
                                    android:id="@+id/btn_undo"
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:layout_gravity="center"
                                    app:tint="@color/selected"
                                    android:src="@drawable/leaflet_ic_n_left_rotate" />

                                <!-- Changes Indicator Badge Dot for Undo -->
                                <View
                                    android:id="@+id/dot_undo_indicator"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginBottom="9dp"
                                    android:background="@drawable/bg_undo_dot_indicator"
                                    android:visibility="gone" />

                                <!-- Free Limit Countdown / Ad Badge for Undo -->
                                <TextView
                                    android:id="@+id/badge_undo_limit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="14dp"
                                    android:minWidth="14dp"
                                    android:paddingHorizontal="3dp"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="11dp"
                                    android:layout_marginBottom="9dp"
                                    android:gravity="center"
                                    android:textColor="#FFFFFF"
                                    android:textSize="8.5sp"
                                    android:textStyle="bold"
                                    android:background="@drawable/bg_badge_limit_free"
                                    android:clickable="false"
                                    android:focusable="false"
                                    android:visibility="gone" />

                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/edit_redo"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">

                                <ImageView
                                    android:id="@+id/btn_redo"
                                    android:layout_width="23dp"
                                    android:layout_height="23dp"
                                    android:layout_gravity="center"
                                    app:tint="@color/selected"
                                    android:src="@drawable/leaflet_ic_n_right_rotate" />

                                <!-- Changes Indicator Badge Dot for Redo -->
                                <View
                                    android:id="@+id/dot_redo_indicator"
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginBottom="9dp"
                                    android:background="@drawable/bg_undo_dot_indicator"
                                    android:visibility="gone" />

                                <!-- Free Limit Countdown / Ad Badge for Redo -->
                                <TextView
                                    android:id="@+id/badge_redo_limit"
                                    android:layout_width="wrap_content"
                                    android:layout_height="14dp"
                                    android:minWidth="14dp"
                                    android:paddingHorizontal="3dp"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="11dp"
                                    android:layout_marginBottom="9dp"
                                    android:gravity="center"
                                    android:textColor="#FFFFFF"
                                    android:textSize="8.5sp"
                                    android:textStyle="bold"
                                    android:background="@drawable/bg_badge_limit_free"
                                    android:clickable="false"
                                    android:focusable="false"
                                    android:visibility="gone" />

                            </FrameLayout>
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/btn_save_template"
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:gravity="center"
                            app:tint="@color/selected"
                            android:src="@drawable/leaflet_ic_n_save" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center">

                        <RelativeLayout
                            android:id="@+id/btn_save_poster"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_btn_blue"
                            android:gravity="center">
                            
                            <ImageView
                                android:id="@+id/iv_download_icon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_download_white" />
                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>

            </RelativeLayout>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottom_ly"
            android:layout_below="@id/top_ly"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:background="#FFFFFF"
            android:visibility="visible">

            <ScrollView
                android:id="@+id/lay_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="150dp"
                android:layout_centerHorizontal="true">

                <com.online.flyer.design.postermaker.Leaflet_view.Leaflet_AspectRatioFrameLayout
                    android:id="@+id/center_rel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="#FFFFFF"
                    app:resize_mode="fit"
                    tools:ignore="MissingClass">

                    <RelativeLayout
                        android:id="@+id/main_rel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        tools:ignore="MissingClass">

                        <ImageView
                            android:id="@+id/background_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY"
                            android:layout_centerInParent="true" />

                        <ImageView
                            android:id="@+id/trans_img"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:scaleType="centerCrop"
                            android:visibility="visible" />

                        <RelativeLayout
                            android:id="@+id/txt_stkr_rel"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:splitMotionEvents="false" />

                        <com.online.flyer.design.postermaker.Leaflet_view.Leaflet_GridLine
                            android:id="@+id/guidelines"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_watermark"
                        android:layout_width="56dp"
                        android:layout_height="46dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="6dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:visibility="visible">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="0dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@android:color/transparent">
                            
                            <ImageView
                                android:id="@+id/btn_watermark"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter"
                                android:src="@drawable/logowatermark" />
                        </androidx.cardview.widget.CardView>

                        <ImageView
                            android:id="@+id/btn_watermark_remove"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentTop="true"
                            android:background="@drawable/bg_watermark_close"
                            android:padding="3dp"
                            android:src="@drawable/leaflet_ic_close"
                            android:visibility="visible" />

                    </RelativeLayout>
                </com.online.flyer.design.postermaker.Leaflet_view.Leaflet_AspectRatioFrameLayout>

            </ScrollView>

        </RelativeLayout>

        <FrameLayout
            android:id="@+id/lay_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottom_ly"
            android:layout_below="@+id/top_ly"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/bottom_ly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_alignParentBottom="true"
            android:background="#FFFFFF"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:weightSum="5">


                <LinearLayout
                    android:id="@+id/add_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:src="@drawable/leaflet_text_press"
                        app:tint="@color/selected" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="@string/text"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/selected"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/add_sticker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/img_sticker"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        app:tint="@color/selected"
                        android:src="@drawable/leaflet_sticker_press" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:layout_marginTop="2dp"
                        android:text="@string/stickers"
                        android:textColor="@color/selected"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/add_effect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/img_effect"
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        app:tint="@color/selected"
                        android:src="@drawable/leaflet_effect_press" />

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="@string/effects"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/selected"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/add_user_image"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        app:tint="@color/selected"
                        android:src="@drawable/leaflet_image_press" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="@string/image"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/selected"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/add_bg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        app:tint="@color/selected"
                        android:src="@drawable/leaflet_bg_press" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/leaflet_visbyroundcf_bold"
                        android:gravity="center"
                        android:text="@string/background"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/selected"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <include layout="@layout/leaflet_text_controller" />

        <include layout="@layout/leaflet_sticker_controller" />

        <include layout="@layout/leaflet_effect_controller" />

        <include layout="@layout/leaflet_temp_layout" />

        <RelativeLayout
            android:id="@+id/lay_sticker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottom_ly"
            android:layout_below="@id/top_ly"
            android:background="#FFFFFF"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/pagerLay"
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <com.online.flyer.design.postermaker.Leaflet_view.Leaflet_PagerSlidingTabStrip
                    android:id="@+id/pagerSlidingTabStrip"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:pstsDividerColor="@color/white"
                    app:pstsIndicatorColor="@color/new_selected"
                    app:pstsTabBackground="@color/transparent"
                    app:pstsTextAllCaps="false"
                    app:pstsUnderlineColor="@color/transparent" />
            </RelativeLayout>

            <androidx.viewpager.widget.ViewPager
                android:id="@+id/stickerViewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/pagerLay" />

        </RelativeLayout>

        <!-- Quick Floating Action Toast Chip / Pill (Tactile Feedback) -->
        <LinearLayout
            android:id="@+id/lay_floating_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/top_ly"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_editor_floating_pill"
            android:clickable="true"
            android:focusable="true"
            android:elevation="30dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_pill_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/leaflet_ic_n_left_rotate"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tv_pill_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Undo"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </RelativeLayout>


</LinearLayout>

