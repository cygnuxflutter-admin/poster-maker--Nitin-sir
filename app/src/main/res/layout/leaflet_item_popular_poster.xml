<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="120dp"
    android:layout_height="160dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <!-- Image area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/poster_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="visible" />

        <!-- Shimmer Skeleton while image is loading -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/poster_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shimmer_auto_start="true"
            app:shimmer_duration="1200"
            app:shimmer_base_alpha="0.35"
            app:shimmer_highlight_alpha="0.85"
            app:shimmer_direction="left_to_right"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_shimmer_rounded_card" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Placeholder centered icon when no API image or on failure -->
        <LinearLayout
            android:id="@+id/poster_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_popular_card"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_poster_placeholder"
                android:alpha="0.35" />
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
