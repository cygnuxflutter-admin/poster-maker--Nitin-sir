<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lay_StkrMain"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_above="@+id/bottom_ly"
    android:splitMotionEvents="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/seekbar_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:visibility="visible">

        <RelativeLayout
            android:layout_width="fill_parent"
            android:layout_height="100.0dip"
            android:splitMotionEvents="false">

            <LinearLayout
                android:id="@+id/ly_controlsShow"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="visible">

                <!-- Row 1: Action buttons [ Duplicate ] [ Lock ] [ Delete ] -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Duplicate Button -->
                    <RelativeLayout
                        android:id="@+id/lay_duplicateSticker"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_duplicate_copy_white"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                                android:includeFontPadding="false"
                                android:text="Duplicate"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Lock Button -->
                    <RelativeLayout
                        android:id="@+id/lay_stk_lock"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_poster_center_lock"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                                android:includeFontPadding="false"
                                android:text="Lock"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Delete Button -->
                    <RelativeLayout
                        android:id="@+id/lay_str_delete"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_delete_trash_white"
                                app:tint="@color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                                android:includeFontPadding="false"
                                android:text="Delete"
                                android:textColor="@color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </RelativeLayout>

                </LinearLayout>

                <!-- Row 2: Precision Arrow Buttons [ < ] [ ^ ] [ v ] [ > ] -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Left Arrow -->
                    <RelativeLayout
                        android:id="@+id/sti_btnLeft"
                        android:layout_width="54dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/leaflet_bt_left"
                            app:tint="@color/white" />
                    </RelativeLayout>

                    <!-- Up Arrow -->
                    <RelativeLayout
                        android:id="@+id/sti_btn_up"
                        android:layout_width="54dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/leaflet_bt_up"
                            app:tint="@color/white" />
                    </RelativeLayout>

                    <!-- Down Arrow -->
                    <RelativeLayout
                        android:id="@+id/sti_btnDown"
                        android:layout_width="54dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/leaflet_bt_down"
                            app:tint="@color/white" />
                    </RelativeLayout>

                    <!-- Right Arrow -->
                    <RelativeLayout
                        android:id="@+id/sti_btnRight"
                        android:layout_width="54dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_centerInParent="true"
                            android:src="@drawable/leaflet_bt_right"
                            app:tint="@color/white" />
                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lay_colorOpacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip">

                    <ImageView
                        android:id="@+id/btnColor"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_centerVertical="true"
                        android:layout_margin="5.0dip"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:src="@drawable/leaflet_ic_color"
                        android:visibility="gone"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/ss"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="5.0dip"
                        android:layout_marginTop="5.0dip"
                        android:layout_marginEnd="5.0dip"
                        android:layout_marginBottom="5.0dip"
                        android:background="@drawable/leaflet_btn_rounded_text_bg"
                        android:src="@drawable/leaflet_ic_br_tranfarant"
                        app:tint="@color/white" />

                    <SeekBar
                        android:id="@+id/alpha_seekBar"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="5.0dip"
                        android:layout_toEndOf="@+id/ss"
                        android:max="100"
                        android:maxHeight="2dp"
                        android:progress="100"
                        android:progressDrawable="@drawable/leaflet_seekbar_new"
                        android:thumbTint="@color/new_selected" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/lay_hue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5.0dip"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/pick_hue_color"
                        android:layout_width="30.0dip"
                        android:layout_height="30.0dip"
                        android:layout_centerVertical="true"
                        android:layout_margin="5.0dip"
                        android:background="@drawable/leaflet_btn_bg"
                        android:padding="5dp"
                        android:src="@drawable/leaflet_ic_hue_seek" />

                    <com.online.flyer.design.postermaker.Leaflet_color_palette.Leaflet_LineColorPicker
                        android:id="@+id/hue_seekBar"
                        android:layout_width="fill_parent"
                        android:layout_height="35.0dip"
                        android:layout_centerInParent="true"
                        android:layout_marginLeft="10.0dip"
                        android:layout_marginRight="10.0dip"
                        android:layout_toEndOf="@+id/pick_hue_color"
                        app:orientation="horizontal" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ly_stk_rotation"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:splitMotionEvents="false"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="fill_parent"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/stk_view_rotate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:fontFamily="visbyroundcf_semibold"
                        android:textColor="@color/selected"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.online.flyer.design.postermaker.Leaflet_view.Leaflet_HorizontalProgressWheelView
                        android:id="@+id/stk_rotate_scroll_wheel"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_50sdp"
                        android:layout_below="@+id/stk_view_rotate"
                        android:layout_toStartOf="@+id/stk_wrapper_rotate_by_angle"
                        android:layout_toEndOf="@+id/stk_wrapper_reset_rotate" />


                    <FrameLayout
                        android:id="@+id/stk_wrapper_reset_rotate"
                        style="@style/ucrop_WrapperRotateButton"
                        android:layout_below="@+id/stk_view_rotate"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="30.0dip"
                            android:layout_height="30.0dip"
                            android:layout_gravity="center"
                            android:layout_margin="5.0dip"
                            android:background="@drawable/leaflet_btn_rounded_text_bg"
                            android:padding="5dp"
                            android:src="@drawable/leaflet_ic_reset" />

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/stk_wrapper_rotate_by_angle"
                        style="@style/ucrop_WrapperRotateButton"
                        android:layout_below="@+id/stk_view_rotate"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentRight="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="30.0dip"
                            android:layout_height="30.0dip"
                            android:layout_gravity="center"
                            android:layout_margin="5.0dip"
                            android:background="@drawable/leaflet_btn_rounded_text_bg"
                            android:padding="5dp"
                            android:src="@drawable/ucrop_ic_angle" />

                    </FrameLayout>

                </RelativeLayout>

            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="45.0dip"
            android:background="#FFFFFF"
            android:orientation="horizontal"
            android:weightSum="4.0">

            <RelativeLayout
                android:id="@+id/btn_controlStkr"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:background="@drawable/leaflet_ripple_effect">

                <TextView
                    android:id="@+id/conTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                    android:text="@string/txt_controls"
                    android:textColor="@color/new_selected"
                    android:textSize="14.0sp" />
            </RelativeLayout>

            <View
                android:layout_width="1.0dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="5.0dip"
                android:layout_marginBottom="5.0dip"
                android:background="@color/new_selected"
                android:visibility="visible" />

            <RelativeLayout
                android:id="@+id/btn_colorOpacity"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="2.0"
                android:background="@drawable/leaflet_ripple_effect">

                <TextView
                    android:id="@+id/coloTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                    android:text="@string/txt_colorOpacty"
                    android:textColor="@color/new_selected"
                    android:textSize="14.0sp" />
            </RelativeLayout>

            <View
                android:layout_width="1.0dip"
                android:layout_height="fill_parent"
                android:layout_marginTop="5.0dip"
                android:layout_marginBottom="5.0dip"
                android:background="@color/new_selected"
                android:visibility="visible" />

            <RelativeLayout
                android:id="@+id/btn_stk_rotation"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:background="@drawable/leaflet_ripple_effect">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/leaflet_visbyroundcf_semibold"
                    android:text="@string/txt_rotation"
                    android:textColor="@color/new_selected"
                    android:textSize="14.0sp" />
            </RelativeLayout>
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>


