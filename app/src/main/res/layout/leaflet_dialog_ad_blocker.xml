<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Red Shield Icon Container -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_button_flat">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ad_blocker_shield" />
            </FrameLayout>

            <!-- Dialog Title -->
            <TextView
                android:id="@+id/tvAdBlockTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:gravity="center"
                android:text="Ad Blocker Detected 🚫"
                android:textColor="#0F172A"
                android:textSize="20sp" />

            <!-- Dialog Message -->
            <TextView
                android:id="@+id/tvAdBlockMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/leaflet_visbyroundcf_regular"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Poster Maker is supported by ads to remain free. We noticed that you are using an Ad Blocker or Private DNS that blocks ads.\n\nPlease turn off your Ad Blocker or disable Private DNS to continue using the app."
                android:textColor="#475569"
                android:textSize="14sp" />

            <!-- Primary Action: Check Again -->
            <Button
                android:id="@+id/btnCheckAgain"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#2563EB"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:text="Check Again 🔄"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:cornerRadius="12dp" />

            <!-- Secondary Action: Open DNS / WiFi Settings -->
            <Button
                android:id="@+id/btnOpenSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#F1F5F9"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:text="Open Settings ⚙️"
                android:textAllCaps="false"
                android:textColor="#1E293B"
                android:textSize="14sp"
                app:cornerRadius="12dp" />

            <!-- Exit App Text Button -->
            <TextView
                android:id="@+id/btnExitApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/leaflet_visbyroundcf_bold"
                android:padding="8dp"
                android:text="Exit App"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
